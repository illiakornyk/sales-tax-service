generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model cities {
  id         BigInt       @id @default(autoincrement())
  state_code String
  city_name  String
  tax_rates  tax_rates[]
  zip_cities zip_cities[]

  @@unique([state_code, city_name], map: "cities_state_city_uniq")
  @@index([state_code], map: "idx_cities_state")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tax_rates {
  id                BigInt            @id @default(autoincrement())
  jurisdiction_type jurisdiction_type
  state_code        String
  county_name       String?
  city_id           BigInt?
  rate              Decimal           @db.Decimal(10, 6)
  start_time        DateTime          @db.Timestamptz(6)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  cities            cities?           @relation(fields: [city_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([jurisdiction_type, state_code, county_name, city_id, start_time], map: "ux_tax_rates_identity_start")
}

model zip_cities {
  zip        String
  city_id    BigInt
  is_primary Boolean   @default(false)
  cities     cities    @relation(fields: [city_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zip_codes  zip_codes @relation(fields: [zip], references: [zip], onDelete: Cascade, onUpdate: NoAction)

  @@id([zip, city_id])
  @@index([city_id], map: "idx_zip_cities_city_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model zip_codes {
  zip               String       @id
  state_code        String
  county_name       String
  primary_city_name String?
  zip_cities        zip_cities[]

  @@index([state_code, county_name], map: "idx_zip_codes_state_county")
}

enum jurisdiction_type {
  STATE
  COUNTY
  CITY
}
